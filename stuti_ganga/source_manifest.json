  {
    "id": 60,
    "title": "दशावतार स्तोत्रम्",
    "source": "/doc_vishhnu/dashAvatArastavaHjayadeva.html",
    "file": "059_shri_dashaavataara_stotram",
    "note": "गीतगोविन्द का जयदेवकृत दशावतारस्तव।"
  },
  {
    "id": 61,
    "title": "दशावतार स्तुति",
    "source": "/doc_vishhnu/dashavatarastuti.html",
    "file": "060_shri_dashaavataara_stuti",
    "note": "वादिराजकृत दशावतारस्तुति; जयदेव के दशावतारस्तव से अलग रचना।"
  },
  {
    "id": 62,
    "title": "गजेन्द्र स्तुति",
    "source": "/doc_vishhnu/gajendramokShaNaH_bhAgavatam.html",
    "file": "061_shri_gajendra_stuti",
    "note": "श्रीमद्भागवत ८.३.२–२९, गजेन्द्र के मुख से कही स्तुति। कथा के अन्य अध्याय यहाँ शामिल नहीं हैं।"
  },
  {
    "id": 63,
    "title": "भीष्म स्तुति",
    "source": "/doc_vishhnu/bhIShmakRRitaM1shrIkRRiShNastotram.html",
